.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Generated media, partial downloads, temporary files, and logs.
*.mp4
*.webm
*.part
*.tmp
*.log
.env
.env.*
credentials.*
secrets.*
data/downloads/*
!data/downloads/.gitkeep
data/logs/*
!data/logs/.gitkeep

# Browser profiles must remain outside this repository.
browser-profile/
**/browser-profile/

# Never commit browser cookies or account state.
**/Cookies
**/Cookies-journal
**/cookies.txt
**/cookies*.json
**/Login Data
**/Login Data-journal
